# Copia este archivo como .env y ajusta los valores.

# Clave secreta de Django. Genera una nueva con:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=cambia-esta-clave-en-produccion

# Modulo de settings: config.settings.local | config.settings.production
DJANGO_SETTINGS_MODULE=config.settings.local

DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Idioma de la interfaz y zona horaria.
# El codigo fuente esta en ingles; locale/es contiene la traduccion al espanol.
# Usa "en" si quieres ver la aplicacion en ingles.
DJANGO_LANGUAGE_CODE=es-mx
DJANGO_TIME_ZONE=America/Mexico_City

# Base de datos.
# Dejala vacia o comentada para usar SQLite en desarrollo.
# Para PostgreSQL:
# DATABASE_URL=postgres://usuario:password@localhost:5432/sistema_creditos
DATABASE_URL=

# Correo (solo produccion)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Produccion
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_CSRF_TRUSTED_ORIGINS=
